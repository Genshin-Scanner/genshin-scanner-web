{
  "name": "genshin-inventory-scanner",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:libs && bun run ocr:assets && vite build apps/web",
    "build:libs": "bun scripts/build-libs.ts",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run test && bun run format:check && bun run typecheck && bun run build",
    "check:frames": "bun scripts/check-frames.ts",
    "ocr:assets": "bun scripts/ocr-assets.ts",
    "check:video": "bun scripts/check-video.ts",
    "dev": "bun run ocr:assets && vite apps/web",
    "check:browser": "node scripts/browser-check.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
